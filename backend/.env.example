# ==============================================================================
# JobPilot Backend - Environment Variables Template (.env.example)
# ==============================================================================
# INSTRUCTIONS FOR BEGINNERS:
# 1. This file is a TEMPLATE containing only variable names and placeholder values.
# 2. DO NOT enter your real secrets into this file (.env.example).
# 3. To set up your local development environment:
#    a. Copy this file and name the copy ".env" (in the same "backend" directory).
#    b. Fill in the real credentials inside your local ".env" file.
# 4. Your ".env" file is listed in .gitignore and will NEVER be uploaded to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & ENVIRONMENT
# ------------------------------------------------------------------------------
# ENVIRONMENT: Set to "development" for local coding, or "production" for deployed server.
ENVIRONMENT=development

# DEBUG: Enable detailed error logging in development (true/false).
DEBUG=true

# API_V1_STR: Prefix for all Phase 2 REST API routes.
API_V1_STR=/api/v1

# BACKEND_CORS_ORIGINS: Comma-separated list of origins allowed to call the backend.
# In local dev: Android emulator (http://10.0.2.2), Vite website (http://localhost:5173).
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://10.0.2.2:8000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: The connection string used by SQLAlchemy to connect to PostgreSQL.
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# For local Windows PostgreSQL installation:
DATABASE_URL=postgresql+psycopg://postgres:your_local_postgres_password@localhost:5432/jobpilot

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: A long, random cryptographic string used to sign user login tokens.
# Generate one locally on Windows using PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY

# JWT_ALGORITHM: Cryptographic algorithm used to sign tokens (HS256 is standard).
JWT_ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: How long a login session token remains valid (in minutes).
# 1440 minutes = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# REFRESH_TOKEN_EXPIRE_DAYS: How long a refresh token remains valid (in days).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. RESUME STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# RESUME_UPLOAD_DIR: Local directory path where uploaded resumes (PDF/DOCX) are stored.
RESUME_UPLOAD_DIR=storage/resumes

# MAX_RESUME_FILE_SIZE_MB: Maximum allowed file size for resume uploads (in MB).
MAX_RESUME_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 5. FUTURE INTEGRATIONS (OPTIONAL - PLACEHOLDERS ONLY)
# ------------------------------------------------------------------------------
# NOTE: The backend will start and run smoothly even if the variables below are empty.
# They are architectural placeholders for future phases.

# --- Google OAuth 2.0 (For Gmail application reply detection) ---
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- GitHub OAuth (For portfolio and project verification) ---
# Obtain from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# --- LinkedIn OAuth (For official profile import) ---
# Obtain from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback

# --- OpenRouter (3 Keys for Rotation & Resilience) ---
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL=deepseek/deepseek-r1-0528

# --- Resend Email OTP (Registration & Forgot Password) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Production Deployment Base URL ---
API_BASE_URL=https://jobpilot-backend-e97f.onrender.com

# --- OpenAI / Alternative NLP Service (Optional fallback) ---
OPENAI_API_KEY=

# --- Firebase Cloud Messaging (For Android push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

